    "UnrollConfig": {
      "description": "Multi-step training. ``k`` model applications per batch; ``curriculum`` is a list of\n``[fraction_of_training, k]`` raising k over time (the largest k is what the data loader\nprovides). ``bptt`` backpropagates through all k steps (truncated BPTT), ``detach`` cuts\nthe gradient between steps, ``pushforward`` (Brandstetter et al. 2022) runs k-1 steps\nwithout gradient and trains on the first and the last step.",
      "properties": {
        "k": {
          "default": 1,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "mode": {
          "default": "bptt",
          "enum": [
            "bptt",
            "detach",
            "pushforward"
          ],
          "title": "Mode",
          "type": "string"
        },
        "curriculum": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Curriculum",
          "type": "array"
        },
        "activation_checkpointing": {
          "default": false,
          "title": "Activation Checkpointing",
          "type": "boolean"
        }
      },
      "title": "UnrollConfig",
      "type": "object"
    }
